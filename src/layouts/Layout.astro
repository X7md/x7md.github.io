---
import { Font } from 'astro:assets';
import { blog } from '../schema.blog';

// Bundled locally instead of being @import-ed from a CDN at runtime.
import 'bootstrap/dist/css/bootstrap-grid.rtl.css';
import 'bootstrap/dist/css/bootstrap-utilities.rtl.css';
import '@picocss/pico/css/pico.amber.min.css';

interface Props {
	title: string;
	description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		{
		((Astro.url.pathname == "/")) ? (
		<meta name="description" 
		 content="مدونة شخصية، محتوى تقني مكتوب باللغة العربية." />
		) : (
		<meta name="description" 
		 content={description} />
		)
		}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-vazirmatn" preload />
		<title>{title}</title>
		{/^\/posts\/\w+\S+\/$/.test(Astro.url.pathname) && <script is:inline type="application/ld+json" set:html={
			blog({
				"@type": "BlogPosting",
				"headline": title,
				"description": description || "مدونة شخصية، محتوى تقني مكتوب باللغة العربية.",
				"@id": `https://blog.x7md.net${Astro.url.pathname}`,
				"mainEntityOfPage": `https://blog.x7md.net${Astro.url.pathname}`,
				"inLanguage": "ar"
			})
		}>
		</script>}
	</head>
	<body>
		<header class="navbar">
		<nav class="container row align-items-center">
			<a href="/" title="المدونة" class="col text-start">
				<span dir="ltr" >
					<b>~X7md</b>
				</span>
			</a>
			<div class="col">
				<menu class="m-0 d-flex justify-content-end gap-3">
					{
						[
						{
							"svg": (
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32"><path fill="currentColor" d="M18 31H6c-1.1 0-2-.9-2-2V12h2v17h12z"/><path fill="currentColor" d="M22 27H10c-1.1 0-2-.9-2-2V8h2v17h12z"/><path fill="currentColor" d="M16 16h8v2h-8z"/><path fill="currentColor" d="m27.7 9.3l-7-7c-.2-.2-.4-.3-.7-.3h-6c-1.1 0-2 .9-2 2v17c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-.3-.1-.5-.3-.7M20 4.4l5.6 5.6H20zM26 21H14V4h4v6c0 1.1.9 2 2 2h6z"/></svg>
							),
							content: "التدوينات",
							link: "/posts"
						},
						{
							"svg": (
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32"><path fill="currentColor" d="M6 30h20v-5a7.008 7.008 0 0 0-7-7h-6a7.008 7.008 0 0 0-7 7zM9 9a7 7 0 1 0 7-7a7 7 0 0 0-7 7"/></svg>
							),
							content: "عني",
							link: "/about"
						}
						].map(
							function(data){
								return (
								<a 
								style="--pico-form-element-spacing-horizontal: 0;
								--pico-background-color: transparent;
								--pico-border-color: transparent;
								--pico-color: none;
								"
								href={data.link}
								class="d-block link contrast"
								>
									{
										data.svg
									}
									<span class="d-none d-lg-inline d-md-inline">
									{data.content}
									</span>
								</a>
								)
							}
						)
					}
				</menu>
			</div>
		</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<p>
				&copy; {new Date().getFullYear()} حمد بنقالي
				&middot; <a href="/posts">التدوينات</a>
				&middot; <a href="/about">عني</a>
			</p>
		</footer>
	</body>
</html>
<style is:global>
	/* ============================================================
	   TOKENS
	   Pico's stylesheet is emitted AFTER this one in the built <head>,
	   and declares its tokens on `:host,:root` (0,1,0). A plain `:root`
	   here loses on source order - which is why Vazirmatn silently never
	   rendered. `:root:root` (0,2,0) wins on specificity instead, and
	   removes the need for the !important declarations that were here.
	   ============================================================ */
	:root:root {
		--pico-font-family-sans-serif: var(--font-vazirmatn);
		--pico-font-family: var(--font-vazirmatn);

		/* Arabic carries dots above and below the baseline and has no
		   x-height rhythm to rest on, so it needs more leading than Latin:
		   Cloudflare runs 1.75 and blog.google 1.625 for Latin body copy. */
		--pico-line-height: 1.85;
		--pico-font-size: 106.25%;            /* 17px - phones */
		--pico-typography-spacing-vertical: 0.75rem;

		/* Surfaces: hairlines carry structure, fills do not.
		   #0B0B0C over pure black for the same reason Cloudflare uses #151414. */
		--pico-background-color: #0B0B0C;
		--pico-card-background-color: transparent;
		--pico-muted-color: #9AA1AE;          /* ~7.4:1 */
		--pico-muted-border-color: #262930;   /* 1.33:1, cf. Google's 1.37:1 divider */
		--pico-blockquote-border-color: #3A3F49;
		--pico-code-background-color: #1B1D22;
		--pico-code-color: #E6E8EC;

		--measure: 40rem;                     /* ~712px of text, approx 74 Arabic cpl */
		--measure-chrome: 44rem;              /* nav sits a little wider than the text */
		--gutter: 1.25rem;
	}
	/* Both references hold body size flat and cap the root size; Pico otherwise
	   climbs to 21.25px on wide screens, which widens the measure for no gain. */
	@media (min-width: 768px)  { :root:root { --pico-font-size: 112.5%;  } }  /* 18px */
	@media (min-width: 1024px) { :root:root { --pico-font-size: 118.75%; } }  /* 19px, flat above */

	/* ============================================================
	   MEASURE - one centred reading column
	   ============================================================ */
	main {
		max-inline-size: var(--measure);
		margin-inline: auto;
		padding-inline: var(--gutter);
		padding-block-end: 3rem;
	}
	main .container { max-inline-size: none; padding-inline: 0; }
	article.post { margin: 0; padding: 0; background: none; box-shadow: none; border-radius: 0; }

	/* ============================================================
	   RHYTHM & SCALE
	   `main x` (0,0,2) beats Pico's bare `x` (0,0,1) regardless of order.
	   ============================================================ */
	/* Cloudflare's paragraph gap == its line-height, with zero variation
	   across 29 measured paragraphs: the blank line is literally one line. */
	main :is(p, ul, ol, dl, blockquote, figure, pre, table) { margin-block-end: 1.85rem; }
	main :is(ul, ol) { padding-inline-start: 1.5rem; }
	main li { margin-block-end: 0.4rem; }

	/* Headings own their space asymmetrically (Cloudflare h2 is 4:1 above:below) */
	main h1 { --pico-font-size: 2.1rem;  --pico-line-height: 1.30; --pico-typography-spacing-top: 0; }
	main h2 { --pico-font-size: 1.6rem;  --pico-line-height: 1.35; --pico-typography-spacing-top: 3rem; }
	main h3 { --pico-font-size: 1.25rem; --pico-line-height: 1.40; --pico-typography-spacing-top: 1.9rem; --pico-color: #DDE1E7; }
	main h4 { --pico-font-size: 1.10rem; --pico-line-height: 1.45; --pico-typography-spacing-top: 1.5rem; --pico-color: #CBD0DA; }
	main :is(h1, h2, h3, h4) { text-wrap: balance; }

	/* ============================================================
	   MEDIA - figures fill the column (were capped at 360px, ~19% of natural)
	   ============================================================ */
	main img { max-inline-size: 100%; block-size: auto; border-radius: 6px; }
	main figure[data-img] { margin-block: 1.85rem; text-align: center; }
	main figure[data-img] figcaption {
		padding-block-start: 0.5rem;
		font-size: 0.8em;
		line-height: 1.6;
		color: var(--pico-muted-color);
	}

	/* ============================================================
	   CODE - one palette, and no longer the smallest text on the page
	   ============================================================ */
	code, kbd, samp {
		direction: ltr;
		unicode-bidi: isolate;
		font-size: 0.9em;
		line-height: inherit;          /* chips must not ratchet the 1.85 leading apart */
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
	code[data-language] {
		direction: ltr;
		unicode-bidi: plaintext;
		overflow-x: auto;
	}
	a code {
		--pico-text-decoration: underline;
		text-decoration-line: underline;
		text-decoration-color: var(--pico-primary-underline) !important;
	}
	main .remark-code-container { margin-block: 1.85rem; }
	main .remark-code-title {
		direction: ltr;
		text-align: start;
		font-size: 0.75em;
		padding: 0.4rem 0.8rem;
		color: var(--pico-muted-color);
		background: #101216;
		border: 1px solid #23262D;
		border-block-end: 0;
		border-radius: 8px 8px 0 0;
	}
	main figure[data-rehype-pretty-code-figure] { margin: 0; }
	main figure[data-rehype-pretty-code-figure] pre {
		background-color: #101216 !important;   /* rehype-pretty-code writes bg inline on <pre> */
		margin: 0;
		padding: 1rem;
		border: 1px solid #23262D;
		border-radius: 8px;
		overflow-x: auto;
	}
	main .remark-code-container > figure[data-rehype-pretty-code-figure] pre { border-radius: 0 0 8px 8px; }
	main figure[data-rehype-pretty-code-figure] pre > code {
		font-size: 0.85em;
		line-height: 1.7;
		padding: 0;
		background: none;
		border-radius: 0;
	}

	/* ============================================================
	   POST LIST - global, so home and /posts cannot diverge again
	   ============================================================ */
	.post-list { list-style: none; margin: 0; padding: 0; }
	.post-list li { margin-block-end: 0; }
	.post-list li + li { border-block-start: 1px solid var(--pico-muted-border-color); }
	.post-list .post-link {
		display: block;
		padding-block: 1.5rem;
		text-decoration: none;
		color: inherit;
	}
	.post-list .post-link h3 {
		--pico-font-size: 1.2rem;
		--pico-line-height: 1.45;
		--pico-color: #F0F1F3;
		--pico-typography-spacing-top: 0;
		margin-block: 0 0.4rem;
	}
	.post-list .post-link p {
		margin-block: 0 0.5rem;
		color: var(--pico-muted-color);
		font-size: 0.92em;
	}
	.post-list .post-link time { font-size: 0.8em; color: var(--pico-muted-color); }
	.post-list .post-link:is(:hover, :focus-visible) h3 {
		--pico-color: var(--pico-primary);
		text-decoration: underline;
	}
	.post-list .post-link:focus-visible {
		outline: 2px solid var(--pico-primary);
		outline-offset: 4px;
		border-radius: 4px;
	}

	/* ============================================================
	   ARTICLE HEADER
	   ============================================================ */
	/* Pico styles article>header as a card-sectioning bar (own background,
	   negative physical margins, bottom border). This is prose, not a card. */
	article.post > .post-header {
		margin: 0 0 2rem;
		padding: 0;
		background: none;
		border: 0;
		border-radius: 0;
	}
	.post-header h1 { margin-block-end: 0.5rem; }
	.post-meta {
		margin-block: 0;
		font-size: 0.8em;
		line-height: 1.6;
		color: var(--pico-muted-color);
	}
	.post-meta time { color: inherit; }

	/* ============================================================
	   SURFACES
	   ============================================================ */
	.author-box {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 0;
		background: none;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}
	/* Breaks out past the prose column, level with the navbar. Gated on a width
	   where --measure is actually capped, so narrow viewports can never overflow. */
	@media (min-width: 900px) {
		.author-box {
			margin-inline: calc((var(--measure) - var(--measure-chrome)) / 2);
		}
	}
	/* ============================================================
	   EXPERIENCE TABLE
	   ============================================================ */
	.exp { margin-block-end: 1.85rem; }
	.exp th, .exp td { vertical-align: middle; }
	.exp .role { text-align: start; }

	/* Two columns do not fit an iPhone-width screen: the role cell was taking
	   240px of 348px and crushing the employer column to 108px, and the nowrap
	   season lines then overflowed it and collided with the role text.
	   Below 640px each row becomes a stacked block instead. */
	@media (max-width: 640px) {
		.exp, .exp caption, .exp tbody, .exp tr, .exp th, .exp td { display: block; inline-size: auto; }
		.exp caption { text-align: start; margin-block-end: 0.5rem; }
		.exp tr {
			padding-block: 1rem;
			border-block-end: 1px solid var(--pico-muted-border-color);
		}
		.exp tr:last-child { border-block-end: 0; }
		.exp th, .exp td { padding: 0; border: 0; }
		.exp .role { margin-block-start: 0.5rem; font-size: 1.05em; }
		.exp .place { display: block; }
	}

	/* experience table: location reads as metadata, not primary text */
	.place { color: var(--pico-muted-color); }
	/* two discrete Hajj seasons at one employer, rather than one long range */
	.seasons { display: flex; flex-direction: column; gap: 0.1rem; font-size: 0.85em; }
	.season { white-space: nowrap; }
	.season b { font-weight: 600; color: var(--pico-primary); margin-inline-end: 0.4em; }
	.author-avatar {
		width: 48px;
		height: 48px;
		aspect-ratio: 1/1;
		object-fit: cover;
		border-radius: 50%;
		border: 1px solid var(--pico-muted-border-color);
	}
	.author-text { display: flex; flex-direction: column; gap: 0.05rem; }
	.author-name { margin-block-end: 0.05rem; font-weight: bold; font-size: 1.05rem; }
	.author-desc { color: var(--pico-muted-color); font-size: 0.92em; }
	.author-hr {
		margin-block: 1.25rem 1rem;
		border: 0;
		block-size: 1px;
		background: var(--pico-muted-border-color);
	}
	blockquote {
		background-color: #FFFFFF08;
		border-color: var(--pico-blockquote-border-color);
		border-start-end-radius: 6px;
		border-end-end-radius: 6px;
	}
	blockquote a { white-space: nowrap; }
	mark {
		background-color: var(--pico-code-background-color);
		border: 0 transparent solid;
		border-bottom: 2px solid deeppink;
		border-radius: 7px;
	}
	[lang="en"] { direction: ltr; }

	/* ============================================================
	   CHROME
	   ============================================================ */
	.navbar {
		position: sticky;
		top: 0;
		z-index: 2;
		background: var(--pico-background-color);
		border-block-end: 1px solid var(--pico-muted-border-color);
		backdrop-filter: blur(0.5px);
	}
	.navbar > .container {
		max-inline-size: var(--measure-chrome);
		padding-inline: var(--gutter);
	}
	.navbar menu a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-block-size: 44px;
		min-inline-size: 44px;
		padding-inline: 0.5rem;
	}
	.site-footer {
		max-inline-size: var(--measure);
		margin-inline: auto;
		padding: 1.5rem var(--gutter) 3rem;
		border-block-start: 1px solid var(--pico-muted-border-color);
		color: var(--pico-muted-color);
		font-size: 0.85em;
		text-align: center;
	}
	.site-footer a { color: inherit; }

	/* rehype-autolink-headings: revealed on hover, never shifts the heading */
	.heading-anchor {
		margin-inline-start: 0.35em;
		text-decoration: none;
		color: var(--pico-muted-color);
		opacity: 0;
		transition: opacity 0.15s ease;
	}
	:is(h1, h2, h3, h4, h5, h6):hover > .heading-anchor { opacity: 1; }
	/* decorative (aria-hidden, tabindex=-1) - no reason to show it on touch */
	@media (hover: none) { .heading-anchor { opacity: 0; } }

	.ratio-1x1 { aspect-ratio: 1/1; object-fit: cover; }
	.avatar-lg {
		width: 80px;
		height: 80px;
		aspect-ratio: 1/1;
		object-fit: cover;
		border-radius: 50%;
		border: 2px solid var(--pico-primary-border);
		transition: transform 0.2s ease;
	}
	.avatar-lg:hover { transform: scale(1.05); }
</style>
